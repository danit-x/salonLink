# --- Secrets: never commit these ---
# Firebase client config. Not a password, but it identifies our project, so keep the repo clean.
# Each team member downloads it from the Firebase console (Project settings → Your apps).
app/google-services.json
# Admin SDK key used only by the seed script.
firebase/seed/service-account*.json

