rules_version = '2';

// =====================================================================================
// SalonLink — Cloud Firestore security rules (v2: accounts, roles, invites, catalogue & booking reads)
// -------------------------------------------------------------------------------------
// These rules run on Google's servers for EVERY read and write. They are the real
// security boundary: even a modified app or a raw API call cannot get past them
// (proposal NFR-04). Anything not explicitly allowed below is denied.
//
// Tested by firebase/tests/rules.test.mjs against the local Firestore emulator.
// =====================================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper functions ----------

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The caller's own profile (users/{their uid}).
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwnerOf(salonId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().role == 'OWNER'
        && myProfile().salonId == salonId;
    }

    // STAFF or OWNER of this salon (the people who run it).
    function isMemberOf(salonId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().role in ['STAFF', 'OWNER']
        && myProfile().salonId == salonId;
    }

    // Invites are keyed by lower-case email, matching the app (FormValidators.normaliseEmail).
    function myEmailKey() {
      return request.auth.token.email.lower();
    }

    function myInvitePath() {
      return /databases/$(database)/documents/invites/$(myEmailKey());
    }

    // Optional string field: missing, null, or a string of at most `max` characters.
    function optionalString(data, field, max) {
      return !(field in data) || data[field] == null
        || (data[field] is string && data[field].size() <= max);
    }

    // Shape check for a profile document: only known fields, with sensible types.
    function validProfileShape(data) {
      return data.keys().hasOnly(['name', 'email', 'phone', 'role', 'salonId', 'staffId', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && data.email == myEmailKey()
        && optionalString(data, 'phone', 16);
    }

    // Role rules at sign-up:
    //  - anyone may become a CUSTOMER (with no salon), or
    //  - take EXACTLY the role/salon/staff record that their invite grants.
    function allowedRole(data) {
      return (data.role == 'CUSTOMER'
                && data.get('salonId', null) == null
                && data.get('staffId', null) == null)
        || (exists(myInvitePath())
                && data.role == get(myInvitePath()).data.role
                && data.get('salonId', null) == get(myInvitePath()).data.salonId
                && data.get('staffId', null) == get(myInvitePath()).data.get('staffId', null));
    }

    // ---------- users/{uid}: one profile per account ----------
    match /users/{uid} {
      // You can read your own profile. (Phase 6 lets staff read their customers' names.)
      allow read: if isUser(uid);

      // Created once, at registration, by the account owner.
      allow create: if isUser(uid)
        && validProfileShape(request.resource.data)
        && allowedRole(request.resource.data)
        && request.resource.data.createdAt == request.time;

      // Users may edit only their name and phone. role, salonId and email are locked.
      allow update: if isUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone'])
        && validProfileShape(request.resource.data);

      // Account deletion is not offered in v1.
      allow delete: if false;

      // ---------- users/{uid}/notifications: the in-app feed (Phase 5) ----------
      // No push server on Spark, so whoever causes an event writes a small document here and
      // the user's app listens to it. Documents use fixed ids (type_bookingId), and an existing
      // one can't be overwritten, so a retry never duplicates an entry.
      match /notifications/{notificationId} {
        allow read, delete: if isUser(uid);

        // The only change allowed: marking as read.
        allow update: if isUser(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;

        // Written by the user themselves (their own booking / cancel / waitlist offer), or by
        // staff of the salon about a booking that really belongs to this user.
        allow create: if validNotification(request.resource.data)
          && (
            (isUser(uid) && request.resource.data.type in ['BOOKING_CONFIRMED', 'BOOKING_CANCELLED', 'WAITLIST_OFFER'])
            || (isMemberOf(request.resource.data.salonId)
                && request.resource.data.type in ['BOOKING_CANCELLED', 'STATUS_CHANGED']
                && get(/databases/$(database)/documents/salons/$(request.resource.data.salonId)/bookings/$(request.resource.data.bookingId)).data.customerId == uid)
          );
      }
    }

    // ---------- Catalogue shapes (v5, Phase 6) ----------
    function shortText(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function validSalon(s) {
      return s.keys().hasOnly(['name', 'address', 'area', 'phone', 'openingHours'])
        && shortText(s.name, 1, 80) && shortText(s.address, 0, 160) && shortText(s.area, 0, 60)
        && (s.phone == null || shortText(s.phone, 0, 20))
        && s.openingHours is map;
    }

    function validService(v) {
      return v.keys().hasOnly(['name', 'description', 'category', 'durationMin', 'price', 'staffIds', 'active'])
        && shortText(v.name, 1, 60) && shortText(v.description, 0, 200)
        && v.category in ['HAIRCUT', 'BEARD', 'COLOUR', 'TREATMENT', 'OTHER']
        // Whole 10-minute slots, at most 16 of them (the booking engine's limit).
        && v.durationMin is int && v.durationMin >= 10 && v.durationMin <= 160 && v.durationMin % 10 == 0
        && v.price is int && v.price >= 0 && v.price <= 1000000
        && v.staffIds is list && v.staffIds.size() <= 50
        && v.active is bool;
    }

    function validStaff(v) {
      return v.keys().hasOnly(['name', 'bio', 'specialties', 'rating', 'reviewCount', 'yearsExperience',
                               'photoUrl', 'portfolioUrls', 'workingHours', 'active'])
        && shortText(v.name, 1, 60) && shortText(v.bio, 0, 300)
        && v.specialties is list && v.specialties.size() <= 10
        && v.yearsExperience is int && v.yearsExperience >= 0 && v.yearsExperience <= 80
        && (v.photoUrl == null || shortText(v.photoUrl, 0, 500))
        && v.portfolioUrls is list && v.portfolioUrls.size() <= 10
        && v.workingHours is map
        && v.active is bool;
    }

    function validNotification(n) {
      return n.keys().hasOnly(['type', 'salonId', 'bookingId', 'title', 'staffName', 'start', 'status', 'read', 'createdAt'])
        && n.type in ['BOOKING_CONFIRMED', 'BOOKING_CANCELLED', 'STATUS_CHANGED', 'WAITLIST_OFFER']
        && n.salonId is string && n.salonId.size() > 0 && n.salonId.size() <= 100
        && n.bookingId is string && n.bookingId.size() > 0 && n.bookingId.size() <= 100
        && n.title is string && n.title.size() <= 200
        && n.staffName is string && n.staffName.size() <= 100
        && n.start is timestamp
        && (n.status == null || n.status is string)
        && n.read == false
        && n.createdAt == request.time;
    }

    // ---------- invites/{email}: grants STAFF/OWNER at registration ----------
    match /invites/{email} {
      // The invited person can read their own invite (the app checks it while registering),
      // and an owner can read the invites for their salon.
      allow read: if (signedIn() && myEmailKey() == email)
        || (signedIn() && isOwnerOf(resource.data.salonId));

      // Only an owner can invite, and only STAFF into their own salon.
      // The first OWNER invite is created with admin access (seed script / console).
      allow create, update: if isOwnerOf(request.resource.data.salonId)
        && request.resource.data.role == 'STAFF'
        && request.resource.data.keys().hasOnly(['role', 'salonId', 'staffId'])
        && email == email.lower();

      allow delete: if isOwnerOf(resource.data.salonId);
    }

    // ---------- salons/{salonId} and its catalogue (v2, Phase 2) ----------
    // Any signed-in user may browse salons, services, staff and staff blocks: customers need
    // them to choose and book (availability needs the staff blocks too).
    // Writes (v5, Phase 6): only the salon's OWNER, with every field checked. New salons are
    // created with admin access (seed script / console), never from the app.
    match /salons/{salonId} {
      allow read: if signedIn();
      allow update: if isOwnerOf(salonId) && validSalon(request.resource.data);

      match /services/{serviceId} {
        allow read: if signedIn();
        // No delete: an old booking may point at it. Retire it with active = false instead.
        allow create, update: if isOwnerOf(salonId) && validService(request.resource.data);
      }

      match /staff/{staffId} {
        allow read: if signedIn();
        // Ratings can't be typed in by the owner: new staff start at 0, existing ones keep theirs.
        allow create: if isOwnerOf(salonId) && validStaff(request.resource.data)
          && request.resource.data.rating == 0 && request.resource.data.reviewCount == 0;
        allow update: if isOwnerOf(salonId) && validStaff(request.resource.data)
          && request.resource.data.rating == resource.data.rating
          && request.resource.data.reviewCount == resource.data.reviewCount;

        match /blocks/{blockId} {
          allow read: if signedIn();
          allow create: if isOwnerOf(salonId)
            && request.resource.data.keys().hasOnly(['start', 'end', 'reason'])
            && request.resource.data.start is timestamp
            && request.resource.data.end is timestamp
            && request.resource.data.start < request.resource.data.end
            && request.resource.data.reason is string && request.resource.data.reason.size() <= 60;
          allow delete: if isOwnerOf(salonId);
        }
      }

      // ---------- Bookings + slot locks: the booking engine (v3, Phase 3, PLAN.md §5) ----------
      //
      // HOW DOUBLE-BOOKING IS MADE IMPOSSIBLE (even for a hacked app):
      //  1. Every booking holds one lock document per 10-minute slot it covers:
      //       slotLocks/{staffId}_{slot}   (slot = minutes since 1970 / 10, see SlotGrid.kt)
      //  2. A document id is unique. Writing a lock that already exists is an UPDATE, and
      //     locks have no update rule, so a second booking for the same slot is always refused.
      //  3. A booking can only be created if its FIRST lock is written with it, and every lock
      //     can only be written if the NEXT one is written with it, up to the last slot.
      //     So, like a row of dominoes, a booking without ALL its locks is refused.
      //
      // WHY the domino chain: rules have no loops, so "check every slot" can't be written
      // directly. Firestore also lets one transaction's rules read at most 20 documents: a
      // booking reads up to 16 locks + the booking + the staff doc + the caller's profile = 19.
      // Hence MAX_SLOTS = 16 (2 h 40 min).

      function maxSlots() { return 16; }              // MUST match SlotGrid.MAX_SLOTS
      function slotMillis() { return 600000; }       // 10 minutes in milliseconds

      function bookingPath(bookingId) {
        return /databases/$(database)/documents/salons/$(salonId)/bookings/$(bookingId);
      }

      function lockPath(staffId, slot) {
        return /databases/$(database)/documents/salons/$(salonId)/slotLocks/$(staffId + '_' + string(slot));
      }

      // The lock for `slot` exists after this write and belongs to booking `bookingId`.
      function lockHeldAfter(staffId, slot, bookingId) {
        return existsAfter(lockPath(staffId, slot))
          && getAfter(lockPath(staffId, slot)).data.bookingId == bookingId;
      }

      // Allowed status changes. MUST match BookingStatus.nextStatuses in Booking.kt.
      function nextStatuses() {
        return {
          'BOOKED': ['CHECKED_IN', 'IN_SERVICE', 'CANCELLED', 'MISSED'],
          'CHECKED_IN': ['WAITING', 'IN_SERVICE', 'CANCELLED'],
          'WAITING': ['IN_SERVICE', 'CANCELLED'],
          'IN_SERVICE': ['COMPLETED'],
          'COMPLETED': [], 'CANCELLED': [], 'MISSED': []
        };
      }

      // Shape and arithmetic of a new booking.
      function validNewBooking(bookingId, b) {
        return b.keys().hasOnly(['salonId', 'customerId', 'customerName', 'staffId', 'staffName',
                                 'services', 'start', 'end', 'startSlot', 'endSlot', 'totalPrice',
                                 'status', 'type', 'note', 'createdAt', 'updatedAt', 'checkedInAt'])
          && b.salonId == salonId
          && b.status == 'BOOKED'
          && b.get('checkedInAt', null) == null
          && b.customerName is string && b.customerName.size() > 0 && b.customerName.size() <= 60
          && b.staffName is string && b.staffName.size() <= 60
          && b.services is list && b.services.size() > 0 && b.services.size() <= 5
          && b.totalPrice is int && b.totalPrice >= 0
          && optionalString(b, 'note', 200)
          && b.createdAt == request.time && b.updatedAt == request.time
          // Slot arithmetic: start is exactly on startSlot; end falls inside the last slot.
          && b.startSlot is int && b.endSlot is int
          && b.endSlot > b.startSlot && b.endSlot - b.startSlot <= maxSlots()
          && b.start.toMillis() == b.startSlot * slotMillis()
          && b.end.toMillis() > (b.endSlot - 1) * slotMillis()
          && b.end.toMillis() <= b.endSlot * slotMillis()
          // The barber exists in this salon.
          && exists(/databases/$(database)/documents/salons/$(salonId)/staff/$(b.staffId))
          // First domino: the first slot is locked for THIS booking in the same write.
          && lockHeldAfter(b.staffId, b.startSlot, bookingId);
      }

      // Who may create it: a customer books for THEMSELVES, in the future. Salon staff/owners
      // may book for anyone (phone bookings) and add walk-ins that started in the current slot.
      function mayCreateBooking(b) {
        return (b.type == 'APPOINTMENT'
                  && signedIn() && b.customerId == request.auth.uid
                  && b.start > request.time)
          || (b.type in ['APPOINTMENT', 'WALK_IN']
                  && isMemberOf(salonId)
                  && b.end > request.time);
      }

      // Salon staff/owners see every booking of THEIR salon; a customer sees only their own (T09).
      match /bookings/{bookingId} {
        // `resource == null`: reading a booking id that doesn't exist yet reveals nothing, and the
        // engine needs it for its idempotency check ("was this booking already saved?").
        allow get: if resource == null
          || isMemberOf(salonId)
          || (signedIn() && resource.data.customerId == request.auth.uid);
        allow list: if isMemberOf(salonId)
          || (signedIn() && resource.data.customerId == request.auth.uid);

        allow create: if validNewBooking(bookingId, request.resource.data)
          && mayCreateBooking(request.resource.data);

        // Customers may only cancel their own booking, before check-in and at least 24 h before
        // the start (BookingPolicy.FREE_CANCELLATION_HOURS). Later, they call the salon.
        // Staff/owners may move it along the status table (check-in, start, complete, no-show…).
        allow update: if request.resource.data.updatedAt == request.time
          && request.resource.data.status in nextStatuses()[resource.data.status]
          && (
            (signedIn() && resource.data.customerId == request.auth.uid
               && resource.data.status == 'BOOKED'
               && request.resource.data.status == 'CANCELLED'
               && resource.data.start > request.time + duration.value(24, 'h')
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
            || (isMemberOf(salonId)
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'checkedInAt']))
          );

        // Bookings are history: never deleted, only CANCELLED / MISSED.
        allow delete: if false;
      }

      function lockIsPartOfBooking(lock, b) {
        return b.staffId == lock.staffId
          && b.status == 'BOOKED'
          && b.startSlot <= lock.slot && lock.slot < b.endSlot
          && (lock.slot + 1 == b.endSlot || lockHeldAfter(lock.staffId, lock.slot + 1, lock.bookingId));
      }

      match /slotLocks/{lockId} {
        // Locks hold no personal data (just ids), so any signed-in user may read them to see
        // which times are taken. That's how customers see availability without being able to
        // read other people's bookings (T09).
        allow read: if signedIn();

        // A lock is created only together with its booking (getAfter = "as it will be after
        // this write"), must lie inside that booking, and must pass the domino on to the next
        // slot unless it is the last one.
        allow create: if request.resource.data.keys().hasOnly(['bookingId', 'staffId', 'slot'])
          && request.resource.data.slot is int
          && lockId == request.resource.data.staffId + '_' + string(request.resource.data.slot)
          && existsAfter(bookingPath(request.resource.data.bookingId))
          && lockIsPartOfBooking(request.resource.data, getAfter(bookingPath(request.resource.data.bookingId)).data);

        // No update rule: an existing lock can never be taken over by another booking.

        // A lock is freed only when its booking becomes CANCELLED / MISSED in the same write,
        // by someone allowed to make that change (the booking's customer or salon staff).
        allow delete: if getAfter(bookingPath(resource.data.bookingId)).data.status in ['CANCELLED', 'MISSED']
          && (isMemberOf(salonId)
              || (signedIn() && getAfter(bookingPath(resource.data.bookingId)).data.customerId == request.auth.uid));
      }
    }

    // "My bookings" searches every salon's bookings at once (a collection-group query).
    // WHY this extra rule: collection-group queries are checked against a `{path=**}` match.
    // Firestore only allows the query if the rule holds for EVERY possible result, so the
    // app must filter on customerId == the caller's uid, or the whole query is refused.
    match /{path=**}/bookings/{bookingId} {
      allow read: if signedIn() && resource.data.customerId == request.auth.uid;
    }

    // Everything else stays locked until later phases add rules for it.
  }
}
